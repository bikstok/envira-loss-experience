#!/usr/bin/env bash
set -e

# Convenience script mirroring Makefile targets
case "$1" in
  start|up)
    docker compose up --build -d
    ;;
  stop|down)
    docker compose down
    ;;
  restart)
    docker compose down
    docker compose up --build -d
    ;;
  test)
    docker compose run --rm loss-experience-api pytest -v "${@:2}"
    ;;
  logs)
    docker compose logs -f "${@:2}"
    ;;
  status|ps)
    docker compose ps
    ;;
  clean)
    docker compose down -v --remove-orphans
    ;;
  *)
    echo "Usage: ./run {start|stop|restart|test|logs|status|clean}"
    echo ""
    echo "Commands:"
    echo "  ./run start    - Build and launch the container in the background (port 8000)"
    echo "  ./run stop     - Stop the running service container"
    echo "  ./run restart  - Restart the service container"
    echo "  ./run test     - Run the full test suite in Docker"
    echo "  ./run logs     - Follow container logs"
    echo "  ./run status   - Check container health status"
    echo "  ./run clean    - Remove containers, volumes, and networks"
    exit 1
    ;;
esac
